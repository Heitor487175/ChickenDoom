{
  "name": "chicken-doom",
  "version": "1.0.1",
  "private": true,
  "description": "Jogo de ação em primeira pessoa com galinhas zumbis através do tempo.",
  "license": "ISC",
  "author": "",
  "desktopName": "OOPS! ALL CHICKENS",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "vite",
    "start": "npm run build && electron .",
    "build": "vite build",
    "package:linux": "npm run build && electron-builder --linux AppImage --publish never",
    "package:windows": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "esbuild": "^0.25.12",
    "fdir": "^6.5.0",
    "nanoid": "^3.3.20",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "pixi.js": "^8.22.0",
    "postcss": "^8.5.29",
    "rollup": "^4.64.3",
    "source-map-js": "^1.2.2",
    "tinyglobby": "^0.2.17"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.4.1"
  },
  "build": {
    "appId": "com.chickendoom.game",
    "productName": "OOPS! ALL CHICKENS",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "dist/**/*",
      "package.json"
    ],
    "publish": null,
    "linux": {
      "executableName": "chicken-doom",
      "syncDesktopName": true,
      "category": "Game",
      "target": [
        "AppImage"
      ],
      "artifactName": "Chicken-Doom-${version}-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Chicken-Doom-Setup.${ext}"
    }
  }
}
